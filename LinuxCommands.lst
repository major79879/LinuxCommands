## === # Major Fast Order # === ##

# # SoftCam Key Updater Order # #
wget -qO- https://raw.githubusercontent.com/major79879/MajorKey/refs/heads/main/SoftCam%20Script%20Updater.sh | bash

# # Clean Memory Order # #
echo 3 > /proc/sys/vm/drop_caches && sync

# # Restart Emu (NCam - OSCam) Order # #
killall -9 ncam oscam 2>/dev/null; sleep 1; /usr/bin/ncam &

# # Restart GUI Order # #
init 4 && init 3

